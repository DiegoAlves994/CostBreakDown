<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FRETE" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.9487171000000014"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PK_NUNICO" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
FRE.SEQ,
(Select OPCAO
  from tddopc p
 where p.nucampo = 9999992195
 AND P.VALOR = FRE.CIF_FOB) TIPO,
SUBSTR(PAR.NOMEPARC,1,30)NOMEPARC,
FRE.SAIDA,
FRE.LOCALENTREGA,
FRE.VEICULO,
FRE.DISTANCIA,
FRE.CUSTOKM,
FRE.QTDPECAS,
NVL(((FRE.DISTANCIA*FRE.CUSTOKM)/FRE.QTDPECAS),0) CUSTO_FRETE


 FROM AD_ZBVFRE FRE
 LEFT JOIN TGFPAR PAR ON PAR.CODPARC = FRE.CODPARC
WHERE FRE.NUNICO = $P{PK_NUNICO}]]>
	</queryString>
	<field name="SEQ" class="java.lang.Integer"/>
	<field name="TIPO" class="java.lang.String"/>
	<field name="NOMEPARC" class="java.lang.String"/>
	<field name="SAIDA" class="java.lang.String"/>
	<field name="LOCALENTREGA" class="java.lang.String"/>
	<field name="VEICULO" class="java.lang.String"/>
	<field name="DISTANCIA" class="java.math.BigDecimal"/>
	<field name="CUSTOKM" class="java.math.BigDecimal"/>
	<field name="QTDPECAS" class="java.math.BigDecimal"/>
	<field name="CUSTO_FRETE" class="java.math.BigDecimal"/>
	<variable name="V_CUSTOFRETE" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CUSTO_FRETE}]]></variableExpression>
	</variable>
