	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PK_NUNICO" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
MP.SEQ,
MP.CODPROD,
PRO.DESCRPROD,
MP.FONTE,
MP.CODVOL,
NVL(MP.QTDLIQUIDO,0) QTDLIQUIDO,
NVL(MP.QTDBRUTO,0) QTDBRUTO,
NVL(MP.QTDBRUTO-QTDLIQUIDO,0) QTDSUCATA,
NVL(MP.VLRSUCATA,0) VLRSUCATA,
NVL(MP.VLRFRETE,0) VLRFRETE,
NVL(MP.VLRUNIT,0) VLRUNIT,
NVL(MP.VLRUNITSEMICMS,0)VLRUNITSEMICMS ,
NVL((MP.QTDBRUTO*MP.VLRUNITSEMICMS),0)-(NVL(MP.QTDBRUTO-QTDLIQUIDO,0)*NVL(MP.VLRSUCATA,0))+NVL(MP.VLRFRETE,0) AS CUSTOTAL


 FROM AD_ZBVITE MP
INNER JOIN TGFPRO PRO ON PRO.CODPROD = MP.CODPROD
WHERE NUNICO =$P{PK_NUNICO}]]>
	</queryString>
	<field name="SEQ" class="java.lang.Integer"/>
	<field name="CODPROD" class="java.lang.Integer"/>
	<field name="FONTE" class="java.lang.String"/>
	<field name="CODVOL" class="java.lang.String"/>
	<field name="QTDLIQUIDO" class="java.math.BigDecimal"/>
	<field name="QTDBRUTO" class="java.math.BigDecimal"/>
