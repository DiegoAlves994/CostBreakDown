	<field name="VLRSUCATA" class="java.math.BigDecimal"/>
	<field name="VLRFRETE" class="java.math.BigDecimal"/>
	<field name="VLRUNIT" class="java.math.BigDecimal"/>
	<field name="VLRUNITSEMICMS" class="java.math.BigDecimal"/>
	<field name="DESCRPROD" class="java.lang.String"/>
	<field name="CUSTOTAL" class="java.math.BigDecimal"/>
	<variable name="TOTALMP" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CUSTOTAL}]]></variableExpression>
	</variable>
