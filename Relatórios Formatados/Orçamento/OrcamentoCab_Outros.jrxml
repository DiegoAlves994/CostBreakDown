	<parameter name="PK_NUNICO" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT

OUT.SEQ,
OUT.DESCRICAO,
OUT.FONTE,
OUT.CODVOL,
OUT.QUANTIDADE,
OUT.VLRFRETE,
OUT.VLRUNIT,
NVL((OUT.QUANTIDADE*OUT.VLRUNIT)+OUT.VLRFRETE,0) CUSTO_TOTAL

FROM AD_ZBVOUT OUT


WHERE OUT.NUNICO = $P{PK_NUNICO}]]>
	</queryString>
