	<parameter name="PK_NUNICO" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
SEQ,
NVL(VLRTOT,0) VLRTOT,
NVL(QTDPECA,0) QTDPECA,
NVL(PRAZO,0) PRAZO,
NVL(VLRTOT/QTDPECA,0) CUSTO_AMORTIZACAO

FROM AD_ZBVAMO
WHERE NUNICO =$P{PK_NUNICO}]]>
	</queryString>
