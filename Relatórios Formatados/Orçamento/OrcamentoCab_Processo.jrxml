	<parameter name="PK_NUNICO" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
CIP.SEQ,
CIP.CODPROD,
PRO.DESCRPROD,
CIP.CAVIDADES,
CIP.CICLO,
CIP.EFICIENCIA,
nvl(CIP.QTDPECAS,0)QTDPECAS,
nvl(CIP.QTDMO,0)QTDMO,
nvl(CIP.VLRCUSTOHH,0) VLRCUSTOHH,
nvl(CIP.VLRCUSTOHM,0) VLRCUSTOHM,
nvl(CIP.VLRCUSTOPROCESSO,0) VLRCUSTOPROCESSO,
NVL(CIP.VLRCUSTOPROCESSO/CIP.QTDPECAS,0) CUSTOTOTAL



FROM AD_ZBVCIP CIP
LEFT JOIN TGFPRO PRO ON PRO.CODPROD = CIP.CODPROD
WHERE CIP.NUNICO = $P{PK_NUNICO}]]>
	</queryString>
	<field name="SEQ" class="java.lang.Integer"/>
	<field name="CODPROD" class="java.lang.Integer"/>
	<field name="DESCRPROD" class="java.lang.String"/>
	<field name="CAVIDADES" class="java.lang.Integer"/>
