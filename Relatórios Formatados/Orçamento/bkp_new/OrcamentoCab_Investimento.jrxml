	<parameter name="PK_NUNICO" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
INV.SEQ,
INV.DESCRICAO,
INV.TIPO,
INV.FONTE,
INV.CODVOL,
NVL(INV.QUANTIDADE,0) QUANTIDADE,
NVL(INV.CUSTO,0) CUSTO,
NVL(INV.QUANTIDADE*INV.CUSTO,0) TOTAL


FROM AD_ZBVINV INV
WHERE INV.NUNICO = $P{PK_NUNICO}]]>
	</queryString>
	<field name="SEQ" class="java.lang.Integer"/>
	<field name="DESCRICAO" class="java.lang.String"/>
