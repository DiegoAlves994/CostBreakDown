	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PK_NUNICO" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
CIP.SEQ,
CIP.CODPROD,
PRO.DESCRPROD,
nvl(CIP.VLRCUSTOPROCESSO,0) VLRCUSTOPROCESSO,
NVL(CIP.QTD,0) QTD,
nvl(CIP.VLRCUSTOPROCESSO,0)*NVL(CIP.QTD,0) CUSTOTOTAL



FROM AD_ZBVCIP CIP
LEFT JOIN AD_ZBVCAB CAB ON CAB.NUNICO = CIP.NUNICO
LEFT JOIN TGFPRO PRO ON PRO.CODPROD = CIP.CODPROD
WHERE CIP.NUNICO = $P{PK_NUNICO}]]>
	</queryString>
	<field name="SEQ" class="java.lang.Integer"/>
	<field name="CODPROD" class="java.lang.Integer"/>
	<field name="DESCRPROD" class="java.lang.String"/>
	<field name="VLRCUSTOPROCESSO" class="java.math.BigDecimal"/>
	<field name="CUSTOTOTAL" class="java.math.BigDecimal"/>
	<field name="QTD" class="java.math.BigDecimal"/>
	<variable name="V_CUSTOTOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CUSTOTOTAL}]]></variableExpression>
	</variable>
